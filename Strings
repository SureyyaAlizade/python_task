    count=0
    for i in x:
        count+=1
        
    return count

def my_find(x,sub):
    index=0
    
    while index<=length(x)-length(sub):
        if x[index:index+length(sub)]==sub:
            return True
        index+=1
        
    return False

def find_index(x,sub):
    index=0
    
    while index<=length(x)-length(sub):
        if x[index:index+length(sub)]==sub:
            return index
        index+=1
        
    return -1

