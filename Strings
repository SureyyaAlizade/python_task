def smart_join(list2):
    result=''

    for i in range(length(list2)):
        if list2[i] in ['-',',','.','?','!','"']:
            result+=list2[i]
        else:
            if i>0 and not list2[i-1] in ['-','"']:
                result+=' '
            result+= list2[i]

    return result

