def my_rep(x,sub,nsub): # string, neyi, ne ile
    new=''
    index=0

    while index<=length(x)-length(sub):
        if x[index:index+length(sub)]==sub:
            new+=nsub
            index+=length(sub)

        else:
            new+=x[index]
            index+=1
    new+=x[index:]    #Adds the remaining part at the end

    return new

