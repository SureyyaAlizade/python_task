def is_float(x): #checks if float
    
    if x=='':
        return False

    if x[0]=='-':
        x=x[1:]

    count=0
    for i in x:
        if i=='.':
            count+=1
            if count>1:
                return False
        elif i<'0' or i>'9':
            return False
    if count==1:
        return True
    else: return False

def is_num(x):  #checks if integer

    if x=='':
        return False

    if x[0]=='-':
        x=x[1:]
        
    for i in x:
        if i<'0' and i>'9':
            return False

    return True
            
    
            
lst=[]
