#Matrix
from random import*

def matrix(n,m):
    A=[]
    for i in range(n):
        A+=[[0]*m]
        for j in range(m):
            if i==0 or i==n-1:
                A[i][j]='*'

            else:
                if j==0:
                    A[i][j]='*'
                elif j==m-1:
                    A[i][j]='*'
                else:
                    A[i][j]='0'
                    
    return A



def print_matrix(A):
    
    for row in A:
        for x in row:
            print(f'{x:4}',end='')
        print()
        
N,M=map(int,input('N,M: ').split())
A=matrix(N,M)
print_matrix(A)
