        A+=[[0]*m]
        for j in range(m):
            if i%2==0:
                if j%2==0:
                   A[i][j]=f'{1}'
                else:  A[i][j]=f'{0}'

            else:
                if j%2==0:
                    A[i][j]=f'{0}'
                else:
                    A[i][j]=f'{1}'
                    
    return A



def print_matrix(A):
    
    for row in A:
