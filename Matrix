from random import*

def matrix(n,m):
   A=[]
   for i in range(n):
       A+=[[0]*m]
       for j in range(m):
            if i<=j and i+j<n:
                A[i][j]=1
            elif i==j or i+j==n-1:
                A[i][j]=1

            elif i>=j and i+j>=n-1:
                A[i][j]=1

        return A        
       


def print_matrix(A):
    
    for row in A:
        for x in row:
            print(f'{x:4}',end='')
        print()
        
