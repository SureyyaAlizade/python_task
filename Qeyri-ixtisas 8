#Task 2
def cut(x):
    new = 0
    pro = 1
    temp = x
    while temp > 0:
        digit = temp%10
        if digit%2 == 0:
            new += digit*pro
            pro *= 10

        temp //= 10

    return new

def quick(A):
    if len(A) <= 1:
        return A

    pivot = cut(A[len(A)//2])  # quick sortda pivot da nezere alinmali
    
    left = [x for x in A if cut(x) < pivot]
    right = [x for x in A if cut(x) > pivot]
    mid = [x for x in A if cut(x) == pivot]

    return quick(left) + mid + quick(right)

