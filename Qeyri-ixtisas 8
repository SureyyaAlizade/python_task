def kod(x):
    i = 0
    n = len(x)
    new = ''

    while i < n:
        if not '0' <= x[i] <= '9':
            new += str(i)

        else:
            new += x[i]

        i += 1

    return new

def ceki(x):
    ceki = 0
    i = 0
    n = len(x)

    while i < len(x):
        if '0' <= x[i] <= '9':
            ceki += int(x[i])
        i += 1

    return ceki

def bubble(x):
    n = len(x)
    for i in range(n):
        for j in range(n-1-i):
            if ceki(x[j]) > ceki(x[j+1]):
                x[j], x[j+1] = x[j+1], x[j]

    return x

