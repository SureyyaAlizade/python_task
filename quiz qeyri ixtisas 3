def guclu(x):
    temp = x
    fakt_cem = 0

    while temp > 0:
        digit = temp%10
        fakt = 1
        for i in range(1, digit+1):
            fakt *= i
        fakt_cem += fakt
        temp //= 10

    return fakt_cem == x

