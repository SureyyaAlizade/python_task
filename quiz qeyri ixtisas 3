#Task 3

def hasil(x):
    addim = 1
    while x >= 10:
        
        temp = x
        print(f'Addim {addim}:',end = ' ')

        div = 1
        while temp//div >= 10:
            div *= 10

        hasil = 1
        while temp > 0:
            digit = temp//div
            if digit != temp%10:
                print(f'{digit} * ', end = '')
            hasil *= digit
            temp %= div
            div //= 10
        print(f'{digit} = {hasil}')
        print()
            
        addim += 1
        x = hasil

    print(f'Yekun = {x}')
    return f'Addim sayi = {addim}'

num = int(input('Enter num: '))
print(hasil(num))
