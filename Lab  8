            if x[j]<x[j+1]:
                x[j],x[j+1]=x[j+1],x[j]

    return x

def sel(x):
    n=length(x)

    for i in range(n):
        idx=i
        for j in range(i+1,n):
            if x[j]>x[idx]:
                idx=j

        x[i],x[idx]=x[idx],x[i]

    return x

def quick(x):
    n=length(x)
    if n<=1:
        return x

    pivot=x[n//2]

    left=[i for i in x if i>pivot]
    mid=[i for i in x if i==pivot]
    right=[i for i in x if i<pivot]

    return quick(left)+mid+quick(right)

def rev(x):  #reverse halves
    n=length(x)
    mid=n//2
   
    for i in range(mid//2):
    
        x[i],x[mid-i-1]=x[mid-i-1],x[i]

        x[mid+i],x[n-1-i]=x[n-1-i],x[mid+i]


