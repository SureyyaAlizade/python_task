from random import*

def l(x):
    l=0
    for i in x:
        l+=1
    return l

def digit(x):
    count=0
    while x>0:
        num=x%10
        if num!=0:
            count+=1
        x=x//10
    return count

def s(x):
    s=0
    while x>0:
        s+=x%10
        x=x//10
    return s

def sel(x):
    n=l(x)
    mid=n//2
    for i in range(mid):
        idx=i
        for j in range(idx+1,mid):
            if digit(x[j])<digit(x[idx]):
                idx=j

        x[i],x[idx]=x[idx],x[i]

    for i in range(mid,n):
        idx=i
        for j in range(i+1,n):
            if s(x[j])>s(x[idx]):
                idx=j

        x[i],x[idx]=x[idx],x[i]

    return x

