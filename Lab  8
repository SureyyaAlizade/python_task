def length(x):
    length=0
    for i in x:
        length+=1
    return length
        
def my_sum(x):
    s=0
    while x>0:
        s+=x%10
        x=x//10
    return s

def bub(x):
    
    n=length(x)
    for i in range(n):
        for j in range(n-1-i):
            if my_sum(x[j])<my_sum(x[j+1]):
                x[j],x[j+1]=x[j+1],x[j]

    return x

def sel(y):

    k=length(y)

    for i in range(k):
        idx=i
        
        for j in range(i+1,k):
            if my_sum(y[j])>my_sum(y[idx]):
                idx=j

        y[i],y[idx]=y[idx],y[i]

    return y

def quick(z):
    if length(z)<=1:
        return z
    pivot=z[length(z)//2]

    left=[x for x in z if my_sum(x)>my_sum(pivot)]
    mid=[x for x in z if my_sum(x)==my_sum(pivot)]
    right=[x for x in z if my_sum(x)<my_sum(pivot)]

    return quick(left)+mid+quick(right)

