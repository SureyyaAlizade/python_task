from random import*
def length(x):
    length=0
    for k in x:
        length+=1
    return length

list1=[randint(0,5) for i in range(5)]

print(list1)
x=int(input("Enter num: "))

i=0;count=0;list2=[]
while i<length(list1):
    if list1[i]==x:
        count+=1
        list2+=[f'A[{i+1}]={x}']
    i+=1

if count==0:
    print('None')

else:
    print('Tapildi: ',end='')
