def length(x):
    a=0
    for i in x:
        a+=1
    return a

def odd(x):
    count=0
    while x>0:
        num=x%10
        if num%2!=0:
            count+=1
        x=x//10
    return count
        
def even(x):
    count=0
    while x>0:
        num=x%10
        if num%2==0:
            count+=1
        x=x//10
    return count

def my_sort(x):
    n=length(x)
    mid=length(x)//2
    for i in range(mid):
        for j in range(mid-1-i):
            if odd(x[j])>odd(x[j+1]):
                x[j],x[j+1]=x[j+1],x[j]

    for i in range(n-mid):
        for j in range(mid,n-1-i):
            if even(x[j])<even(x[j+1]):
                x[j],x[j+1]=x[j+1],x[j]

    return x

