from random import*
def length(x):
    length=0
    for i in x:
        length+=1
    return length

def sel(A):
    c1=0
    N=length(A)
    for i in range(N-1):
        nmin=i
        for j in range(i+1,N):
            if A[j]<A[nmin]:
                nmin=j
                
        if i!=nmin:
            A[i],A[nmin]=A[nmin],A[i]
            c1+=1
    return c1


def bub(A):
    c2=0
    for i in range(length(A)-1):
        for j in range(length(A)-2,i-1,-1):
            if A[j+1]<A[j]:
                A[j],A[j+1]=A[j+1],A[j]
                c2+=1
    return c2


