#Task 5
def digit(x):
    return '0' <= x <= '9'

def ch(x):
    return 'a' <= x <= 'z' or 'A' <= x <= 'Z' 

def my_split(x):
    ls = []
    i = 0
    n = len(x)
    word = ''
    while i < n:
        if ch(x[i]) or digit(x[i]):
            word += x[i]

        else:
            if word != '':
                ls += [word]
                word = ''

        i += 1

    if word != '':
        ls += [word]

    return ls

def hasil(s):
    hasil = 1
    var = 0
    for _ in s:
        if digit(_):
            var = 1
            hasil *= int(_)

    if var == 0:
        hasil = 0

    return hasil

