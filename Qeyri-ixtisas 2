def length(x):

    length=0
    while x>0:
        length+=1
        x//=10

    return length

def arms(x):

    arms=0
    original=x
    
    while x>0:
        digit=x%10
        arms+=digit**length(original)
        x=x//10

    if arms==original:
        return True
    else: return False

