def digit(x):
    if 0 <= x <= 9:
        return x

    step = 0
    while x > 9:  # x tek reqemli olmadigi muddetce
        temp = x
        sum_num = 0
        
        while temp > 0:  #x-in req cem tap
            dig = temp%10
            temp //= 10
            sum_num += dig

        x = sum_num  # x-i req cem ile evezle
        step += 1

    return x, step

    
