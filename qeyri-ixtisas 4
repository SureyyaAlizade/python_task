#Task 4
def prime(x):
    if x < 2:
        return False
    elif x == 2:
        return True
    elif x%2 == 0:
        return False

    for i in range(3, int(x**0.5) + 1, 2):
        if x%i == 0:
            return False

    return True

def decimal(x):
    new = 0
    temp = x
    count = 0
    while temp > 0:
        count += 1
        temp //= 10

    temp = x
    for i in range(count):
        digit = temp%10
        new += digit*2**i
        temp //= 10

    return new
    
num = int(input('Enter binary num: '))
print(prime(decimal(num)))

